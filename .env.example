# Copy to .env.local and set to YOUR deployed Render URL (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://YOUR-SERVICE.onrender.com

# Supabase project settings -> API. Only the publishable (anon) key belongs in
# Expo. NEVER put a service-role or other Supabase secret in these files.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
