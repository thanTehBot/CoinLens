OPENAI_API_KEY=
NUMISTA_API_KEY=
PCGS_BEARER_TOKEN=
SHEETDB_URL=
ADMIN_CODE=
# Set MOCK_MODE=true for deterministic keyless Render testing.
MOCK_MODE=false
# Legacy alias. Prefer MOCK_MODE for new deployments.
USE_MOCK_COIN_RESPONSE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never include this in the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Vision-capable OpenAI model used for the single identification call.
OPENAI_MODEL=gpt-4o-mini
# M6 cost protection: AI attempts (not just saved scans) per user per UTC day,
# backed by the api_usage table (see supabase/migrations). Independent of any
# spending limit set on the OpenAI account itself.
DAILY_SCAN_LIMIT=20
# Per-image byte cap after base64 decoding.
MAX_IMAGE_BYTES=8388608
# Overall request body cap (covers a front+back base64 upload).
MAX_CONTENT_LENGTH_BYTES=25165824
OPENAI_TIMEOUT_SECONDS=60
NUMISTA_TIMEOUT_SECONDS=20
PCGS_TIMEOUT_SECONDS=20

# V1: eBay listing generation is off by default. The implementation is kept
# intact behind this flag (see /api/generate-ebay-listing) for a later
# re-enable; set to true to turn it back on.
ENABLE_EBAY_LISTING=false
